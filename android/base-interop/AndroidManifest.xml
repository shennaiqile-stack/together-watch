<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.watchtogether.phone.interop" android:versionCode="15" android:versionName="5.4">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="一起看·互通版"
        android:usesCleartextTraffic="true" android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="com.watchtogether.phone.NextActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
